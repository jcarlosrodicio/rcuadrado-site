---
import '../styles/global.css';
import type { Lang } from '../data/projects';
import { UI, home } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Ruta equivalente en el otro idioma. */
  alt: string;
  section?: 'work';
  /** Datos estructurados schema.org para esta página. */
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}
const { lang, title, description, alt, section, jsonLd, noindex } = Astro.props;
const t = UI[lang];
const h = home(lang);
const other: Lang = lang === 'es' ? 'en' : 'es';
const canonical = new URL(Astro.url.pathname, Astro.site);
const altUrl = new URL(alt, Astro.site);
const spanish = lang === 'es' ? canonical : altUrl; // versión por defecto
const ogImage = new URL(`/og-${lang}.png`, Astro.site);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  {noindex && <meta name="robots" content="noindex">}
  <link rel="canonical" href={canonical}>
  <link rel="alternate" hreflang={lang} href={canonical}>
  <link rel="alternate" hreflang={other} href={altUrl}>
  <link rel="alternate" hreflang="x-default" href={spanish}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="sitemap" href="/sitemap.xml">
  <meta property="og:site_name" content="Rcuadrado">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'}>
  <meta property="og:locale:alternate" content={lang === 'es' ? 'en_GB' : 'es_ES'}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>
  <header class="top">
    <div class="wrap">
      <a class="logo" href={h}><span class="sq">R<sup>2</sup></span>rcuadrado</a>
      <ul class="menu">
        <li><a href={`${h}#trabajo`} aria-current={section === 'work' ? 'page' : undefined}>{t.nav.work}</a></li>
        <li><a href={`${h}#trayectoria`}>{t.nav.career}</a></li>
        <li><a href={`${h}#que-hago`}>{t.nav.what}</a></li>
        <li><a href={`${h}#contacto`}>{t.nav.contact}</a></li>
      </ul>
      <a class="lang" href={alt} hreflang={other} lang={other}>
        {lang === 'es' ? <><b>ES</b> / EN</> : <>ES / <b>EN</b></>}
        <span class="sr-only">{t.otherLang}</span>
      </a>
      <a class="btn primary" href={`${h}#contacto`}>{t.write}</a>
    </div>
  </header>

  <slot />

  <footer class="foot"><div class="wrap"><span>{t.footer}</span><span><slot name="foot" /></span></div></footer>

  <script is:inline define:vars={{ lang }}>
    // Recalcula "hace X días" con la fecha real del visitante, no la del build.
    const DAY = 86400000;
    document.querySelectorAll('time[data-ago]').forEach((el) => {
      const d = Math.max(0, Math.round((Date.now() - new Date(el.getAttribute('datetime')).getTime()) / DAY));
      el.textContent = lang === 'es'
        ? d === 0 ? 'hoy' : d === 1 ? 'ayer' : d < 14 ? `hace ${d} días` : `hace ${Math.round(d / 7)} semanas`
        : d === 0 ? 'today' : d === 1 ? 'yesterday' : d < 14 ? `${d} days ago` : `${Math.round(d / 7)} weeks ago`;
    });
  </script>
</body>
</html>

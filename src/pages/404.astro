---
import Layout from '../layouts/Layout.astro';
import Bar from '../components/Bar.astro';
---
<Layout lang="es" title="Página no encontrada · Rcuadrado" description="Esta página no existe." alt="/en/" noindex>
  <section class="lost">
    <div class="wrap">
      <Bar lang="es" alt="/en/" />
      <p class="code tt">404</p>
      <h1>Esta página no existe.<br><span class="casual" lang="en">This page does not exist.</span></h1>
      <p class="go"><a href="/">Ir al inicio →</a><a href="/en/" lang="en">Go to the English site →</a></p>
    </div>
  </section>
</Layout>

<style>
  .lost { min-height: 100vh; background: var(--night); color: var(--cream); }
  .code { margin-top: clamp(64px, 12vw, 160px); font-size: 13px; color: var(--orange); }
  h1 { margin-top: 16px; font-size: clamp(40px, 6vw, 88px); line-height: 1; }
  h1 span { font-weight: 700; color: var(--cream-2); }
  .go a { color: var(--cream); }
</style>

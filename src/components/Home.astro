---
import Layout from '../layouts/Layout.astro';
import Bar from './Bar.astro';
import Contact from './Contact.astro';
import Mark from './Mark.astro';
import { GENERATED_AT, PROJECTS, type Lang, type Project } from '../data/projects';
import { CAREER, CONTACT, EDUCATION, PERSON, RECOMMENDATIONS, STATUS, UI, WHAT_I_DO, home, projectUrl } from '../i18n';
import { r1, smooth } from '../lib/ridge';
import { ago } from '../lib/time';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = UI[lang];
const other: Lang = lang === 'es' ? 'en' : 'es';
const locale = lang === 'es' ? 'es-ES' : 'en-GB';
const ref = new Date(GENERATED_AT);
const date = ref.toLocaleDateString(locale, { day: 'numeric', month: 'short', year: 'numeric' });
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { ...PERSON, description: t.description },
    { '@type': 'WebSite', '@id': 'https://rcuadrado.es/#website', url: 'https://rcuadrado.es/', name: 'Rcuadrado', inLanguage: ['es', 'en'], publisher: { '@id': PERSON['@id'] } },
  ],
};

const byId = (id: string) => PROJECTS.find((p) => p.id === id)!;
const since = (p: Project) => {
  const d = new Date(p.activity!.since);
  const m = d.toLocaleDateString(locale, { month: 'long', ...(d.getFullYear() !== ref.getFullYear() && { year: 'numeric' }) });
  return `${p.activity!.commits.toLocaleString(locale)} ${t.commitsSince} ${m}`;
};
// Primera frase de la descripción larga, para los capítulos donde no cabe entera
const lead = (s: string) => s.match(/^.+?\.(?=\s|$)/)?.[0] ?? s;

// Crestas: commits por semana de cada proyecto, de atrás (lo más antiguo) hacia delante;
// lo que no tiene git queda al final. Escala en raíz cuadrada para que los proyectos
// pequeños no desaparezcan junto a los grandes.
const WEEKS = 4;
const rows = [...PROJECTS].sort((a, b) =>
  a.activity && b.activity ? a.activity.since.localeCompare(b.activity.since) : Number(!a.activity) - Number(!b.activity));
const series = rows.map((p) => p.activity?.weeks.slice(-WEEKS) ?? Array(WEEKS).fill(0));
const peak = Math.max(1, ...series.flat());
const total = series.flat().reduce((s, v) => s + v, 0);
const VW = 1000, TOP = 84, GAP = 42, AMP = 72;
const H = TOP + GAP * (rows.length - 1) + 6;
const ridges = rows.map((p, i) => {
  const base = TOP + i * GAP;
  const pts = series[i].map((v, k) => [(k * VW) / (WEEKS - 1), base - Math.sqrt(v / peak) * AMP]);
  const d = smooth(pts, base);
  return { p, base, line: d, fill: `${d} L${VW},${base + 1} L0,${base + 1} Z`, end: pts[WEEKS - 1] };
});

const tally = byId('tally');
const agents = ['norma', 'aqorin', 'oak'].map(byId);
const norma = byId('norma');
const cine = byId('cinepedia');
const featured = ['tally', 'cinepedia', ...agents.map((p) => p.id)];
const rest = PROJECTS.filter((p) => !featured.includes(p.id));

// Trayectoria como diagrama de Gantt: "MM/AAAA" pasa a años decimales
const year = (s: string | null) => {
  if (!s) return ref.getFullYear() + ref.getMonth() / 12;
  const [m, y] = s.split('/').map(Number);
  return y + (m - 1) / 12;
};
const y0 = Math.min(...CAREER.map((j) => year(j.from)));
const y1 = year(null);
const pos = (y: number) => `${r1(((y - y0) / (y1 - y0)) * 100)}%`;
const ticks = Array.from({ length: Math.floor(y1) - Math.ceil(y0) + 1 }, (_, i) => Math.ceil(y0) + i).filter((y) => y % 2 === 0);

const firstSentence = (s: string) => s.match(/^.+?[.!](?=\s|$)/)?.[0] ?? s;
---
<Layout lang={lang} title={t.title} description={t.description} alt={home(other)} jsonLd={jsonLd}>
  <div class="home">
    <section class="cover">
      <div class="wrap">
        <Bar lang={lang} alt={home(other)} />

        <div class="cover-grid">
          <div>
            <h1>{t.heroA} <span class="casual">{t.heroB}</span></h1>
            <p class="lede">{t.lede}</p>
            <p class="reach">
              <a class="mail" href={`mailto:${CONTACT.email}`}>{t.write} →</a>
              <a href={CONTACT.cv} download>{t.downloadCv}</a>
              <a href={CONTACT.github}>GitHub</a>
              <a href={CONTACT.linkedin}>LinkedIn</a>
            </p>
          </div>

          <figure class="plot" data-plot>
            <div class="field" style={`height:${H}px`}>
              <ol class="names" aria-hidden="true">
                {ridges.map((r, i) => <li><a href={projectUrl(lang, r.p.id)} tabindex="-1" data-i={i} style={`top:${r.base}px;--c:${r.p.color}`}>{r.p.name}</a></li>)}
              </ol>
              <svg viewBox={`0 0 ${VW} ${H}`} preserveAspectRatio="none" role="group" aria-label={t.chartLabel}>
                {ridges.map((r, i) => (
                  <a href={projectUrl(lang, r.p.id)} class="r" data-i={i} style={`--c:${r.p.color}`} aria-label={`${r.p.name}. ${r.p.tagline[lang]}`}>
                    <path class="fill" d={r.fill} />
                    <path class="line" d={r.line} />
                    <path class="dot" d={`M${r1(r.end[0])},${r1(r.end[1])} h0`} />
                  </a>
                ))}
              </svg>
            </div>
            <div class="ticks"><span>{t.weeksAgo}</span><span>{t.today}</span></div>
            <figcaption aria-live="polite">
              <p data-cap="-1"><b>{t.chartTitle}</b> {total.toLocaleString(locale)} {t.chartTotal} {date}. <span class="tt">{t.chartHint}</span></p>
              {rows.map((p, i) => (
                <p data-cap={i} hidden>
                  <b style={`--c:${p.color}`}>{p.name}</b> · {p.tagline[lang]}
                  <span class="tt">
                    {STATUS[lang][p.status]}
                    {p.activity && <> · {since(p)} · <time data-ago datetime={p.activity.last}>{ago(p.activity.last, lang, ref)}</time></>}
                    {p.now && <> · {t.nowPrefix}: {p.now[lang]}</>}
                  </span>
                </p>
              ))}
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section id="trabajo" class="work-head">
      <div class="wrap"><h2>{t.work}</h2></div>
    </section>

    <!-- Tally: el color del producto a sangre; los móviles se salen por abajo -->
    <article class="ch-tally" style={`--c:${tally.color}`}>
      <div class="wrap">
        <div>
          <h3 class="ch-name">{tally.name}</h3>
          <p class="ch-tag">{tally.tagline[lang]}</p>
          <p class="about">{tally.about[lang]}</p>
          <p class="meta tt"><span>{STATUS[lang][tally.status]}</span>{tally.version && <span>{tally.version[lang]}</span>}{tally.activity && <span>{since(tally)}</span>}</p>
          <p class="go">
            {tally.links.map((l) => <a href={l.url}>{l.label[lang]} ↗</a>)}
            <a href={projectUrl(lang, tally.id)}>{t.details} →</a>
          </p>
        </div>
        {tally.gallery && (
          <div class="phones">
            {[0, 1, 5].map((k) => <img src={tally.gallery![k]} alt={`${t.screenshots} ${tally.name}`} width="601" height="1300" loading="lazy" />)}
          </div>
        )}
      </div>
    </article>

    <!-- Agentes: el vídeo de norma y los comandos de verdad -->
    <article class="agents">
      <div class="wrap">
        {norma.video && (
          <figure class="reel">
            <video src={norma.video.src} poster={norma.video.poster} muted loop playsinline controls preload="none" data-autoplay aria-label={`${t.launchVideo}: ${norma.name}`}></video>
            <figcaption class="tt">{t.launchVideo}: {norma.name}{norma.version && ` ${norma.version[lang].split(' · ')[0]}`}</figcaption>
          </figure>
        )}
        <div>
          {agents.map((p) => (
            <div class="agent" style={`--c:${p.color}`}>
              <h3><i aria-hidden="true"></i>{p.name}<small class="tt">{p.version?.[lang] ?? STATUS[lang][p.status]}</small></h3>
              <p><b>{p.tagline[lang]}</b> {lead(p.about[lang])}</p>
              {p.cli && <div class="cmd tt"><code><span aria-hidden="true">$ </span>{p.cli}</code><button type="button" class="copy" data-copy={p.cli} data-done={t.copied}>{t.copy}</button></div>}
              <p class="go">
                {p.links.map((l) => <a href={l.url}>{l.label[lang]} ↗</a>)}
                <a href={projectUrl(lang, p.id)}>{t.details} →</a>
              </p>
            </div>
          ))}
        </div>
      </div>
    </article>

    <!-- Cinepedia: tira de capturas sobre su rojo -->
    <article class="cine" style={`--c:${cine.color}`}>
      <div class="wrap head">
        <h3 class="ch-name">{cine.name}</h3>
        <p>{cine.tagline[lang]}</p>
      </div>
      {cine.gallery && (
        <div class="strip" tabindex="0" aria-label={`${t.screenshots} ${cine.name}`}>
          {cine.gallery.map((src) => <img src={src} alt="" width="675" height="1200" loading="lazy" />)}
        </div>
      )}
      <div class="wrap">
        <p class="meta tt">
          {cine.version && <span>{cine.version[lang]}</span>}
          {cine.links.map((l) => <a href={l.url}>{l.label[lang]} ↗</a>)}
          <a href={projectUrl(lang, cine.id)}>{t.details} →</a>
        </p>
      </div>
    </article>

    <section class="sec more">
      <div class="wrap">
        <h3 class="more-title">{t.more}</h3>
        <ul>
          {rest.map((p) => (
            <li><a href={projectUrl(lang, p.id)} style={`--c:${p.color}`}>
              <Mark p={p} size={44} />
              <span><b>{p.name}</b><span class="t">{p.tagline[lang]}</span></span>
              <span class="now tt">{p.now?.[lang]}</span>
              <span class="st tt">{p.activity ? `${p.activity.commits.toLocaleString(locale)} commits` : STATUS[lang][p.status]}</span>
            </a></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="sec" id="que-hago">
      <div class="wrap">
        <h2>{t.what}</h2>
        <ol class="what">
          {WHAT_I_DO[lang].map((w, i) => (
            <li><span class="n tt">{String(i + 1).padStart(2, '0')}</span><h3>{w.title}</h3><p>{w.text}</p><em class="tt">{t.proof} {w.proof}</em></li>
          ))}
        </ol>
      </div>
    </section>

    <section class="sec career" id="trayectoria">
      <div class="wrap">
        <h2>{t.career}</h2>
        <ol class="gantt">
          {CAREER.map((j) => (
            <li class:list={{ current: !j.to }}>
              <div><b>{j.company}</b><span>{j.role} · {j.place[lang]}</span></div>
              <div class="track"><i style={`left:${pos(year(j.from))};width:calc(${pos(year(j.to))} - ${pos(year(j.from))})`} data-label={!j.to ? t.today : undefined}></i></div>
            </li>
          ))}
        </ol>
        <div class="years tt" aria-hidden="true"><span></span><div>{ticks.map((y) => <span style={`left:${pos(y)}`}>{y}</span>)}</div></div>
        <div class="career-more">
          <p>{CAREER[0].text[lang]}</p>
          <p><b>{t.education}:</b> {EDUCATION[lang].map(([when, what, where]) => `${what}, ${where} (${when})`).join('; ')}. <a href={CONTACT.cv} download>{t.downloadCv}</a></p>
        </div>
      </div>
    </section>

    <section class="sec voices" id="recomendaciones">
      <div class="wrap">
        <h2>{t.recs}</h2>
        {RECOMMENDATIONS.map((r, i) => (
          <figure data-rec={i} hidden={i > 0}>
            <blockquote lang={r.lang}>{firstSentence(r.text[0])}</blockquote>
            <figcaption>
              <b>{r.name}</b> · {t.recsRel[r.relation]} · {t.recsAt} {r.company}
              {r.lang !== lang && <span class="tt"> · {t.recsOriginal}</span>}
            </figcaption>
          </figure>
        ))}
        <div class="picker" role="group" aria-label={t.recs} data-picker>
          {RECOMMENDATIONS.map((r, i) => <button type="button" data-i={i} aria-pressed={i === 0 ? 'true' : 'false'}>{r.name.split(' ')[0]}</button>)}
          <a href={`${CONTACT.linkedin}/details/recommendations/`}>{t.recsLink} ↗</a>
        </div>
      </div>
    </section>

    <Contact lang={lang} />
  </div>
</Layout>

<script>
  // Crestas: al pasar por una línea (o por su nombre) se resalta y el pie cuenta qué es
  const plot = document.querySelector<HTMLElement>('[data-plot]')!;
  const caps = plot.querySelectorAll<HTMLElement>('[data-cap]');
  const marks = plot.querySelectorAll<HTMLElement | SVGElement>('[data-i]');
  const show = (i: string | null) => {
    plot.toggleAttribute('data-on', i !== null);
    marks.forEach((el) => el.classList.toggle('on', el.dataset.i === i));
    caps.forEach((c) => (c.hidden = c.dataset.cap !== (i ?? '-1')));
  };
  const pick = (e: Event) => show((e.target as Element).closest<HTMLElement | SVGElement>('[data-i]')?.dataset.i ?? null);
  plot.addEventListener('pointerover', pick);
  plot.addEventListener('focusin', pick);
  plot.addEventListener('pointerleave', () => show(null));
  plot.addEventListener('focusout', () => show(null));

  // Recomendaciones: una a la vez
  const picker = document.querySelector<HTMLElement>('[data-picker]')!;
  picker.addEventListener('click', (e) => {
    const b = (e.target as Element).closest('button');
    if (!b) return;
    picker.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll<HTMLElement>('[data-rec]').forEach((f) => (f.hidden = f.dataset.rec !== b.dataset.i));
  });

  // El vídeo de norma solo se descarga y reproduce cuando entra en pantalla, y nunca si se pide menos movimiento
  const video = document.querySelector<HTMLVideoElement>('video[data-autoplay]');
  if (video && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    new IntersectionObserver(([e]) => { if (e.isIntersecting) video.play().catch(() => {}); else video.pause(); }, { threshold: 0.4 }).observe(video);
  }
</script>

<style>
  h2 { font-size: clamp(34px, 4.4vw, 60px); line-height: 1; margin-bottom: clamp(32px, 5vw, 56px); }
  .sec { padding: clamp(72px, 10vw, 140px) 0; }

  /* ── portada (noche) ── */
  .cover { background: var(--night); color: var(--cream); padding-bottom: clamp(48px, 7vw, 96px); }

  .cover-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 5vw, 80px); align-items: end; padding-top: clamp(40px, 7vw, 104px); }
  h1 { font-size: clamp(44px, 4.8vw, 76px); font-weight: 820; line-height: 0.98; letter-spacing: -0.035em; text-wrap: balance; }
  h1 .casual { color: inherit; font-weight: 700; letter-spacing: -0.02em; }
  .lede { margin-top: 28px; max-width: 46ch; color: var(--cream-2); font-size: 19px; }
  .reach .mail { font-size: 22px; font-weight: 650; color: var(--orange); text-decoration-color: currentColor; }
  .reach .mail:hover { color: var(--orange); }

  /* crestas: SVG estirado en horizontal; los nombres van en HTML para que no se deformen */
  .plot { min-width: 0; }
  .field { position: relative; display: grid; grid-template-columns: 150px minmax(0, 1fr); }
  .names { list-style: none; position: relative; }
  .names a { position: absolute; right: 14px; transform: translateY(-100%); padding-bottom: 2px; font-size: 13px; line-height: 1.15; text-align: right; text-decoration: none; color: var(--cream-2); --mono: 1; transition: color 0.25s; }
  .names a.on { color: oklch(from var(--c) max(l, 0.84) c h); }
  svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .r { outline: none; cursor: pointer; }
  /* entrada de izquierda a derecha, recortando el contenedor HTML (nombres y crestas a la vez) */
  .field { animation: reveal 1.8s var(--expo) 0.1s both; }
  .fill { fill: oklch(from var(--c) 0.235 calc(c * 0.4) h); transition: fill 0.3s; }
  .line { fill: none; stroke: oklch(from var(--c) max(l, 0.76) c h); stroke-width: 1.8; stroke-linejoin: round; vector-effect: non-scaling-stroke; transition: stroke 0.25s, stroke-opacity 0.25s, stroke-width 0.25s; }
  .dot { stroke: oklch(from var(--c) max(l, 0.76) c h); stroke-width: 6; stroke-linecap: round; vector-effect: non-scaling-stroke; transition: stroke-opacity 0.25s; }
  .r:hover .line, .r:focus-visible .line, .r.on .line { stroke: oklch(from var(--c) max(l, 0.84) c h); stroke-width: 2.6; }
  .r:hover .fill, .r:focus-visible .fill, .r.on .fill { fill: oklch(from var(--c) 0.32 calc(c * 0.7) h); }
  .r:focus-visible .line { stroke-width: 3.4; }
  .plot[data-on] .r:not(.on) .line, .plot[data-on] .r:not(.on) .dot { stroke-opacity: 0.25; }
  .plot[data-on] .r:not(.on) .fill { fill: var(--night); }
  @keyframes reveal { from { clip-path: inset(-20px 100% 0 0); } to { clip-path: inset(-20px 0 0 0); } }
  .ticks { display: flex; justify-content: space-between; margin: 10px 0 0 150px; font-size: 12px; color: var(--cream-2); --mono: 1; }
  figcaption[aria-live] { min-height: 4.2em; margin-top: 16px; padding-top: 14px; border-top: 1px solid oklch(0.76 0.02 85 / 0.25); font-size: 15px; color: var(--cream-2); }
  figcaption[aria-live] b { font-weight: 700; color: var(--cream); }
  figcaption[aria-live] b[style] { color: oklch(from var(--c) max(l, 0.8) c h); }
  figcaption[aria-live] .tt { display: block; margin-top: 4px; font-size: 13px; }

  /* ── trabajo ── */
  .work-head { padding-top: clamp(72px, 10vw, 140px); }
  .work-head h2 { margin-bottom: clamp(32px, 5vw, 64px); }

  .ch-tally { background: oklch(from var(--c) calc(l - 0.09) c h); color: var(--cream); overflow: hidden; }
  .ch-tally .wrap { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 5vw, 80px); padding-top: clamp(56px, 7vw, 96px); }
  .ch-tag { font-size: clamp(22px, 2.2vw, 30px); font-weight: 600; letter-spacing: -0.015em; line-height: 1.2; margin-top: 20px; }
  .ch-tally .about { margin-top: 20px; max-width: 46ch; opacity: 0.86; font-size: 17px; }
  .ch-tally .meta { opacity: 0.8; }
  .ch-tally .go { padding-bottom: clamp(56px, 7vw, 96px); }
  .phones { display: flex; gap: clamp(12px, 1.6vw, 24px); align-items: flex-start; justify-content: flex-end; height: 0; min-height: 100%; }
  .phones img { width: min(31%, 236px); height: auto; border-radius: 30px; border: 7px solid oklch(0.16 0.01 260); box-shadow: 0 2px 8px oklch(0.1 0.02 260 / 0.3); }
  .phones img:nth-child(2) { margin-top: 56px; }
  .phones img:nth-child(3) { margin-top: 112px; }

  .agents { padding: clamp(72px, 9vw, 128px) 0; }
  .agents .wrap { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
  .reel video { display: block; width: 100%; aspect-ratio: 1; border-radius: 6px; background: var(--night); }
  .reel figcaption { font-size: 13px; color: var(--ink-2); margin-top: 10px; }
  .agent + .agent { margin-top: 44px; padding-top: 36px; border-top: 1px solid var(--rule); }
  .agent h3 { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; font-size: clamp(36px, 4.2vw, 58px); font-weight: 880; letter-spacing: -0.045em; line-height: 1; }
  .agent h3 i { width: 0.32em; height: 0.32em; background: var(--c); flex: none; align-self: center; }
  .agent h3 small { font-size: 13px; font-weight: 500; letter-spacing: 0; color: var(--ink-2); }
  .agent p { margin-top: 12px; max-width: 56ch; color: var(--ink-2); }
  .agent p b { color: var(--ink); font-weight: 600; }
  .agent .go { margin-top: 14px; font-size: 16px; }

  .cine { padding: clamp(56px, 7vw, 96px) 0 clamp(28px, 3vw, 40px); background: linear-gradient(to bottom, var(--paper) 0 42%, oklch(from var(--c) calc(l - 0.03) c h) 42% 100%); }
  .cine .head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px 32px; }
  .cine .ch-name { font-size: clamp(44px, 6vw, 88px); }
  .cine .head p { max-width: 46ch; color: var(--ink-2); }
  .cine .meta { color: var(--cream); margin-top: 20px; }
  .cine .meta a { text-underline-offset: 3px; }

  .more { padding-top: 0; }
  .more-title { font-size: clamp(26px, 2.6vw, 36px); font-weight: 820; letter-spacing: -0.03em; margin: clamp(56px, 7vw, 96px) 0 16px; }
  .more ul { list-style: none; border-top: 1px solid var(--rule); }
  .more a { display: grid; grid-template-columns: 44px minmax(0, 1.1fr) minmax(0, 1.4fr) auto; gap: 20px; align-items: center; padding: 18px 8px; border-bottom: 1px solid var(--rule); text-decoration: none; transition: background 0.2s; }
  .more a:hover { background: oklch(from var(--c) l c h / 0.08); }
  .more b { display: block; font-size: 20px; font-weight: 750; letter-spacing: -0.02em; }
  .more .t { font-size: 15px; color: var(--ink-2); }
  .more .now, .more .st { font-size: 13px; color: var(--ink-2); }
  .more .st { white-space: nowrap; }

  /* ── qué hago ── */
  #que-hago { padding-top: 0; }
  .what { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(24px, 3vw, 40px); list-style: none; }
  .what li { border-top: 2px solid var(--ink); padding-top: 18px; }
  .what .n { font-size: 13px; color: var(--orange); }
  .what h3 { font-size: 21px; font-weight: 750; letter-spacing: -0.02em; line-height: 1.2; margin-top: 10px; }
  .what p { font-size: 16px; color: var(--ink-2); margin-top: 10px; }
